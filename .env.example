# 本文件所有账号、密钥、域名均为假值，不能直接用于生产环境。
# 复制为 .env 后，按下方说明替换；.env 已被根 .gitignore 排除。

# Android 公网回退地址。
# 当前项目使用 Zeronews 将本机服务端口 8888 暴露为 HTTPS 公网地址；
# 也可换用其他内网穿透工具，只需填写其分配的服务 origin，不要带 API 路径。
ANDROID_PUBLIC_BASE_URL=https://orange.example.com

# Vite 开发服务器将浏览器的 /api 请求代理到本机 Go 服务。
WEB_BACKEND_URL=http://127.0.0.1:8888

# 允许访问 Vite 开发服务器的主机名。公网域名应与穿透工具分配的域名一致。
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,orange.example.com

# DeepSeek API Key，从 DeepSeek 开放平台创建。
# 当前实现仅支持 DeepSeek 的请求和响应协议，暂不支持其他大模型厂商。
LLM_API_KEY=replace-with-deepseek-api-key

# MySQL 8 DSN。先创建 orange 数据库和专用账号，再替换用户名与密码。
MYSQL_DSN=orange:replace-with-mysql-password@tcp(127.0.0.1:3306)/orange?charset=utf8mb4&parseTime=True&loc=Local

# ECDICT SQLite 数据库路径。ECDICT 是必需依赖，服务启动时会校验文件和 stardict 表。
# 从 https://github.com/skywind3000/ECDICT/releases 下载 SQLite 版本并解压。
ECDICT_PATH=./data/ecdict/stardict.db

# 下载及合成后的音频存储目录，相对路径以 server/ 启动目录为基准。
AUDIO_DIR=./data/audio

# 火山引擎语音合成配置，从火山引擎语音技术控制台获取。
# 当前实现仅支持火山引擎 Seed-TTS 2.0，暂不支持其他语音合成厂商。
VOLC_TTS_API_KEY=replace-with-volcengine-api-key
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_SPEAKER=replace-with-english-speaker-id
